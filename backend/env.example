# Application
ENVIRONMENT=development
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=lakeview
ADMIN_PASSWORD=replace-with-a-long-random-password
CORS_ORIGINS=http://localhost:3000

# Persistent object storage (Cloudflare R2 or another S3-compatible provider)
STORAGE_BACKEND=s3
STORAGE_APP_NAME=lakeview
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=lakeview-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Local development only; never use local storage in production.
# STORAGE_BACKEND=local
# MEDIA_STORAGE_DIR=./media_storage
