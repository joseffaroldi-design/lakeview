{
  "typography": {
    "primary_font": "Playfair Display",
    "secondary_font": "Lato",
    "accent_font": "Great Vibes",
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap",
    "usage": {
      "headings": "font-serif tracking-tight font-bold",
      "body": "font-sans leading-relaxed",
      "accents": "font-accent text-gold"
    }
  },
  "colors": {
    "theme": "light",
    "palette": {
      "background": "40 33% 96%",
      "foreground": "217 33% 17%",
      "primary": "217 33% 17%",
      "primary_foreground": "40 33% 96%",
      "secondary": "140 30% 30%",
      "secondary_foreground": "40 33% 96%",
      "accent": "45 29% 50%",
      "accent_foreground": "217 33% 17%",
      "muted": "40 20% 90%",
      "muted_foreground": "217 20% 40%",
      "card": "40 33% 98%",
      "card_foreground": "217 33% 17%",
      "border": "217 33% 17%"
    },
    "hex_reference": {
      "navy": "#1d2a3b",
      "forest_green": "#366343",
      "cream": "#fcfbf7",
      "gold": "#a5935b"
    }
  },
  "visual_enhancers": {
    "texture": "bg-[url('https://www.transparenttextures.com/patterns/cream-paper.png')]",
    "borders": "border-double border-4 border-primary/20",
    "shadows": "shadow-[4px_4px_0px_0px_rgba(29,42,59,0.2)]",
    "radius": "rounded-sm"
  },
  "layout": {
    "structure": "Single page scrolling (Hero -> About -> Menu -> Contact)",
    "container": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8",
    "spacing": "py-20 md:py-32 gap-12"
  },
  "components": {
    "Hero": {
      "description": "Full screen height. Vintage postcard aesthetic. Logo centered.",
      "elements": [
        "Logo: Centered, large (w-64 md:w-96)",
        "Background: Parallax effect with NOLA street scene or subtle texture",
        "Tagline: 'Market • Kitchen • Catering' in accent font",
        "CTA: 'View Menu' button with vintage border style"
      ]
    },
    "Menu": {
      "description": "Classic paper menu look. Two columns. Dotted leaders.",
      "structure": "Grid cols-1 md:cols-2 gap-16",
      "item_style": "Flex justify-between items-baseline border-b border-primary/10 pb-2 mb-6"
    },
    "About": {
      "description": "Storytelling section. Split layout.",
      "structure": "Grid cols-1 md:cols-2 gap-12 items-center",
      "content": "History of the restaurant, connection to New Orleans."
    },
    "Contact": {
      "description": "Footer area with map and details.",
      "style": "bg-primary text-primary-foreground p-12"
    }
  },
  "images": {
    "logo": "https://customer-assets.emergentagent.com/job_703dcc6a-aa7a-4633-a18d-a8d37a8eb209/artifacts/y3vh8170_5D695FC6-4513-41E6-8C85-02DA2EA2EF08.png",
