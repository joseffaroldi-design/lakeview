    "menu_burger": "https://images.unsplash.com/photo-1632898657999-ae6920976661?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjY2NzN8MHwxfHNlYXJjaHwxfHxnb3VybWV0JTIwYnVyZ2VyJTIwd29vZGVuJTIwdGFibGV8ZW58MHx8fHwxNzcwMjE4OTg5fDA&ixlib=rb-4.1.0&q=85",
    "menu_seafood": "https://images.unsplash.com/photo-1715609374345-d652ce42303c?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA1OTV8MHwxfHNlYXJjaHwxfHxmcmllZCUyMHNocmltcCUyMGJhc2tldCUyMG5ldyUyMG9ybGVhbnN8ZW58MHx8fHwxNzcwMjE4OTk0fDA&ixlib=rb-4.1.0&q=85",
    "about_img": "https://images.unsplash.com/photo-1549965738-e1aaf1168943?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA1ODR8MHwxfHNlYXJjaHwyfHxuZXclMjBvcmxlYW5zJTIwZnJlbmNoJTIwcXVhcnRlciUyMHN0cmVldCUyMGRheXRpbWV8ZW58MHx8fHwxNzcwMjE5MDA0fDA&ixlib=rb-4.1.0&q=85"
  },
  "instructions_to_main_agent": [
    "Update tailwind.config.js to include the new fonts and colors.",
    "Update index.css with the HSL variables provided.",
    "Create a 'Navbar' component that is sticky and changes style on scroll.",
    "Use the 'texture' class on the main background to give it a paper feel.",
    "Ensure all buttons have the 'shadows' and 'borders' defined in visual_enhancers.",
    "Use 'data-testid' for all interactive elements."
  ],
  "UNIVERSAL_GUIDELINES_FOR_MAIN_AGENT": [
    "Do not use generic centered layouts. Use asymmetry where possible.",
    "Create depth through layered design elements.",
    "Use 2-3x more spacing than feels comfortable.",
    "Every interaction needs micro-animations.",
    "Use 'sonner' for toasts."
  ]
}